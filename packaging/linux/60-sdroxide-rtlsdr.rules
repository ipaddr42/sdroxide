# RTL2832U (RTL-SDR) dongles, for sdroxide's native USB driver.
#
# sdroxide talks to these directly with nusb rather than through libusb or
# libSoapySDR, but the kernel-level requirement is the same: the invoking user
# needs write access to the usbfs node, both to open the device and to detach
# the dvb_usb_rtl28xxu DVB driver from it.
#
# TAG+="uaccess" hands an ACL to whoever is logged in at the active seat, which
# needs no group to exist and no re-login. It is the better half of this rule
# and it is not the whole of it: uaccess grants nothing where there is no seat
# to be logged in at — WSL2, a headless box reached over ssh, a container, or
# sdroxide running as a systemd service — and the device stays root-owned and
# unreachable for reasons nothing on screen explains (issue #350).
#
# So GROUP="plugdev" comes along as a fallback, taking effect for anyone in
# that group when the ACL does not. To use it:
#
#   sudo groupadd -f plugdev && sudo usermod -aG plugdev $USER
#
# then log out and back in (`newgrp plugdev` for the current shell).
#
# That fallback is why the permissions below are applied on their own lines at
# the end rather than appended to each id. udev resolves GROUP at parse time,
# and a group that does not exist on this machine — plugdev ships on Debian and
# Ubuntu, but not on Arch or Fedora — discards THE WHOLE RULE LINE, not just the
# GROUP token. Written the obvious way, as one line per id carrying MODE, GROUP
# and TAG together, a missing plugdev takes uaccess down with it and the device
# stays root-owned on exactly the distros that never had the group (issue #350
# again, from the other side). Keeping GROUP alone on its own line means only
# that line is dropped and the ACL still lands.
#
# Install:
#   sudo cp 60-sdroxide-rtlsdr.rules /usr/lib/udev/rules.d/
#   sudo udevadm control --reload
# then unplug and replug the dongle.
#
# If the distribution's own rtl-sdr package is installed, its rules already
# cover these ids and this file is harmless duplication.

# The two generic Realtek ids, which cover the overwhelming majority of dongles
# including every RTL-SDR Blog V3 and V4.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2832", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", ENV{SDROXIDE_RTLSDR}="1"

# OEM-branded DVB-T sticks built on the same silicon.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0413", ATTRS{idProduct}=="6680", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0413", ATTRS{idProduct}=="6f0f", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0458", ATTRS{idProduct}=="707f", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00a9", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00b3", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00b4", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00b5", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00b7", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00b8", ENV{SDROXIDE_RTLSDR}="1"
