SUBSYSTEM=="usb", ATTRS{idVendor}=="1b80", ATTRS{idProduct}=="d395", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b80", ATTRS{idProduct}=="d397", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b80", ATTRS{idProduct}=="d398", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b80", ATTRS{idProduct}=="d39d", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b80", ATTRS{idProduct}=="d3a4", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b80", ATTRS{idProduct}=="d3a8", ENV{SDROXIDE_RTLSDR}="1"
