SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00c6", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00d3", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00d7", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00e0", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1554", ATTRS{idProduct}=="5020", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="15f4", ATTRS{idProduct}=="0131", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="15f4", ATTRS{idProduct}=="0133", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="185b", ATTRS{idProduct}=="0620", ENV{SDROXIDE_RTLSDR}="1"
