SUBSYSTEM=="usb", ATTRS{idVendor}=="1d19", ATTRS{idProduct}=="1101", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d19", ATTRS{idProduct}=="1102", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d19", ATTRS{idProduct}=="1103", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d19", ATTRS{idProduct}=="1104", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="a803", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="b803", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="c803", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="d286", ENV{SDROXIDE_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="d803", ENV{SDROXIDE_RTLSDR}="1"

# Permissions, applied on their own lines — see the note at the top of this
# file for why GROUP must not share a line with TAG+="uaccess".
ENV{SDROXIDE_RTLSDR}=="1", MODE="0660", TAG+="uaccess"
ENV{SDROXIDE_RTLSDR}=="1", GROUP="plugdev"
